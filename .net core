******************** Inbuilt Identity User manager & signin manager services **********************
UserManager<IdentityUser> :- is used to create/update/delete a user info. In order to use this service we have inject this into AccountController.
	Its methods :- CreateAsync, UpdateAsync, DeleteAsync etc.
SignInManager<IdentityUser> :- This service is useful for allowing a user to signin. This also need to be injected in controller.
	Its Methods:- SignedInAsync, SignedOutAsync, IsSignedIn etc..
	
	public class AccountController {
		private UserManager<IdentityUser> _userManager;
		private SignInManager<IdentityUser> _signinManager;
		
		public AccountController(UserManager<IdentityUser> userManager, SignInManager<IdentityUser> signinManager){
			this._userManager = userManager;
			this._signinManager = signinManager;
		}
		
		//async operation
		public async Task<IActionResult> Register(RegisterViewModel model) {
			if(ModelState.IsValid){ //if valid info, save user
				var user = new IdentityUser();
				user.Name = model.Name;//... copy all values
				
				//pass IdentityUser and password info for creating user.
				//once record is created in database, password is hashed before storing in DB
				var result = await userManager.CreateAsync(user, model.Password); 
				
				//if user creation is successful, then signin the user
				if(result.Succeded){
					//isPersistent:true - for persisent cookie, user login is retained forever
					//isPersistent:false - for session specific. Once user logsout or browser closes, it will be auto logged out
					signinManager.SignInAsync(user, isPersistent: false); 
				}
				
				//in case user creation fails , we have to show errors.
				foreach(var error in result.Errors){
					ModelState.AddModelError("", error.Description);
				}
			}
			return view(model); //if not valid render the same view with validation error
		}
	}

