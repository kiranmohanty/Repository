	}
	
	public class AccountController : Controller{
		[HttpGet]
		public IActionResult Login() {
			return view();
		}
		
		[HttpPost]
		public async Task<IActionResult> Login(LoginViewModel model){
			if(ModelState.IsValid){
				//Here isPersistent is related to login cookie, lockOutOnFailure is for locking account in case of invalid login details
				SignInResult result = await signinManager.PasswordSignInAsync(userName: model.EmailId,
				password: model.Password, isPersistent: model.RememberMe, lockOutOnFailure: false);
								
				if(result.Succeded){
					return RedirectToAction("index","Home");
				}
				
				//if signin failed, we should show error message to the user 
				ModelState.AddModelError("", "Invalid Login attempt");
			}
			
			return view(); for invalid user info, show error infor on Login page
		}
	}

Once user is logged in , a cookie with name "AspNetCore.Identity.Application" gets created. We can see this cookie under
