export class AuthGuard implements CanActivate{           // CanActivate implementation is required.
  constructor(private loginService : LogInService, private router : Router){}
  CanActivate(next : ActivatedRouteSnapshot, state: RouterStateSnapshot){
    if(this.loginService.isValidUser){
      return true;                                 //return statement is required in order to decide whether to redirect or not !
    }
    else{
       this.router.navigate(['/Login'],queryParams: {redirectTo: state.url});
       return false;
    }
  }
}
