export class VehicleListComponents implements onInit{           // onInit is an interface that has method ngOnInit()
   vehicles : Vehicle[],
   errorMessage:string,
      
   constructor(private objVehicleService: VehicleService) {
   
   getVehicles(){
     this.objVehicleService.getVehicles().subscribe(          // subsribe method points to observable method error or map method of the service
         vehicles => this.vehicles=vehicles,
         error=> this.errorMessage=<any>error
     );
   }
   ngOnInit(){
      this.getVehicles();
   }
}


