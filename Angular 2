  //Input & output parameter for a component (class)
  export class xClass implements OnInit{
     @Output changedEvent=new EventEmitter<character>();
     @Input inputParam: number;
     
     constructor(private serviceObject :xService){}
     
     
     ngOnInit(){
        this.serviceObject.AnyServiceMethod(this.inputParam);
        this.changed.emit(changedEvent);
     }
  }
   
   
