import {Injectable} from '@angular/core';
import {Http, Response} from '@angualr/http';
import {Observable} from 'rxjs/observable';
import 'rxjs/add/operator/map';  // for importing map() method
import 'rxjs/observable/throw'; // for importing throw() method

@Injectable()
export class VehicleService{
  constructor(private htttp: Http) {}
  getVehicles(){
     return this.http.get('api/vehicleJSOnFile')
     .map((response: Response)=> <Vehicle[]> response.json().data)  //data is the object name in json file.
     .catch((error: Response)=> function(error) {
       let errMsg='Satus code ${error.status} on url ${error.url}'; // error mesg will be like 'Satus code 404 on url http:/localhost/3000/service'
       console.log(errMsg);
       return observable.throw(error.json().error || 'Server Error');
     })
  }
}

