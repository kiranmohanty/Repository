////RMP pattern- Revealing module pattern (namespace concept)

var module = (function(){
    function vehicle(vid, vName){
        var self= this;
        self.vid = vid;
        self.vName = vName;
        self.getvId = function(){
            return self.vid;
        }            
        self.setvId = function(vId){
            self.vid = vId;
        }
    }
    // instanciation
    var ford = new vehicle(1,"test");

    //reveal properties (from outside we can access below properties)
    return {
        getRegisteredName : ford.getvId(),
        setRegisteredName: ford.setvId(1,"test2")
    }
    
    console.log(ford);
    //window.module.getRegisteredName -> in browser-> output (1)
})();

