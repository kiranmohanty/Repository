import { MsalService } from '@azure/msal-angular';

constructor(private msalService: MsalService) {}

login() {
    this.msalService.loginRedirect({
        scopes: [
            'api://YOUR-API-CLIENT-ID/access.api'
        ]
    });
}

The browser is redirected to: login.microsoftonline.com
The user authenticates.
After successful authentication, Entra returns the appropriate tokens through the MSAL flow.

With MSAL Angular, you normally configure an HTTP interceptor so that MSAL obtains/acquires the token and attaches it to matching API requests.

