****** Web Module***************************
web server is a software application that receives http request from client and returns a page as response.

Creating web server using node.js
--------------------------------
http module helps in creating http client which can listen to a specific port number.
ex:- requesting a html page from client

//console.log(__filename);
var http = require("http");
var fs = require("fs");
var url = require("url");

http.createServer(function (request, response) {
    //url path
    var path = url.parse(request.url).pathname;
    console.log("request received from " + path);

    //read  htm file returned by URL
    fs.readFile(path.substr(1), function (error, data) {
        console.log(error);
        console.log(data);
        if (error) {
            response.writeHead(404, { 'Content-Type': 'text/html' }); //page not found
        }
        else {
            response.writeHead(200, { 'Content-Type': 'text/html' }); //response ok
        }

        //write response in body
        response.write(data.toString());
        response.end();
    });    

}).listen(8081);

console.log("server is running on http:/localhost:8081/index.htm");

