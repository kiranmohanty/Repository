** Reading a file
fs.read(fd, buffer, offset, length, position, callback
    fd:- this is the file descripture returned by fs.open()
	buffer:- this is the buffer that the data will be written to // read from a file and write to it
	offset:- offset position of buffer, where to start writting
	length:- length of data to read
	position:- at what position to start reading
	callback:- async result function
	
ex:-
var fs = require("fs");
var buf = new Buffer(1024);

console.log("Going to open an existing file");
fs.open('input.txt', 'r+', function(err, fd) {
   if (err) {
      return console.error(err);
   }
   console.log("File opened successfully!");
   console.log("Going to read the file");
   fs.read(fd, buf, 0, buf.length, 0, function(err, bytes){
      if (err){
         console.log(err);
      }
      console.log(bytes + " bytes read");
      
      // Print only read bytes to avoid junk.
      if(bytes > 0){
         console.log(buf.slice(0, bytes).toString());
      }
   });
});
	
