** get file info
fs.stat(path, callback)
     callback function contains fs.stats class object which has few info regarding file specified in the path.
     path:- directory path
     callback:- asynch callback function 
ex-	 
var fs = require("fs");

console.log("Going to get file info!");
fs.stat('input.txt', function (err, stats) {
   if (err) {
       return console.error(err);
   }
   console.log(stats);
   console.log("Got file info successfully!");
   
   // Check file type
   console.log("isFile ? " + stats.isFile());
   console.log("isDirectory ? " + stats.isDirectory());    
});

