 ****************** L shape*****************
int starCount =5;
for(int i=1; i <=starCount; i++){
    for (int j =1; j <= i; j++){
        Console.Write("* ");
    }
    Console.WriteLine("");
}

********************inverted L shape ************************
for(int i=starCount; i >=1; i--){
    for (int j =i; j >= 1; j--){
        Console.Write(" *");
    }
    Console.WriteLine("");
}

*******************Piramid**********************
int starCount =5;
for(int i=1; i <= starCount; i++){
    for (int j = starCount -1; j >= i; j--){
        Console.Write(" ");
    }
    for (int k = 1; k <= i; k++){
        Console.Write("* ");
    }
    Console.WriteLine("");
}

*******************reverse piramid*******************
int starCount =5;
for(int i=starCount; i >= 1; i--){
	for (int j = starCount-i; j >= 1; j--){
		Console.Write(" ");
	}
	for (int k = i; k >= 1; k--){
		Console.Write("* ");
	}
	Console.WriteLine("");
}
        
******************Diamond*****************
int starCount =5;
for(int i=1; i <= starCount; i++){
	for (int j = starCount -1; j >= i; j--){
		Console.Write(" ");
	}
	for (int k = 1; k <= i; k++){
		Console.Write("* ");
	}
	Console.WriteLine("");
}
for(int i=starCount-1; i >= 1; i--){
	for (int j = starCount-i; j >= 1; j--){
		Console.Write(" ");
	}
	for (int k = i; k >= 1; k--){
		Console.Write("* ");
	}
	Console.WriteLine("");
}		
